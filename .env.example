# ─────────────────────────────────────────────────────────────────────────────
# Discord Manager — frontend environment
#
# ⚠️ BACKEND COORDINATION REQUIRED
#
# The admin dashboard and the public attendance form ship from THIS SINGLE
# ORIGIN, but the backend builds its CORS allowlist from two separate variables
# and runs with `credentials: true` (so `*` is never used). This origin must
# therefore appear in **BOTH** of these on the backend:
#
#     APP_URL=<this origin>              # used by the admin dashboard
#     ATTENDANCE_FORM_URL=<this origin>  # used by /attendance
#
# Both accept a comma-separated list. If the origin is missing from
# ATTENDANCE_FORM_URL only, the dashboard works fine while the attendance
# form's browser-direct verification calls fail CORS — which looks like a bug
# in the form rather than a configuration problem. Set both, restart the
# backend, and do it *before* deploying this app.
# ─────────────────────────────────────────────────────────────────────────────

# Server-only base URL for the admin API. Never prefix this with NEXT_PUBLIC_:
# the admin API is reached from the Next server, so the browser must never see
# it, and the access token must never leave the server.
API_BASE_URL=http://localhost:8000/api

# Browser-visible base URL. Used ONLY by the public attendance form, whose
# username verification fires on a 500 ms keystroke debounce — proxying each
# call through the Next server would double the latency of an endpoint that is
# public by design and rate-limited per IP.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Daily-status dashboard feature flag. Server-side, defaults to OFF.
#
# The per-member daily status view, the seven overview counts, search/filter,
# the member detail view and CSV/Excel export are implemented against the
# contract in API_INTEGRATION.md §13 — but the backend exposes those over NO
# HTTP route today (they exist only in its repository layer). While this flag
# is off the page renders an explanatory state and issues no request, so no
# `API Not Found!` 404 is ever produced and no fabricated figure is ever shown.
#
# Turn this on only once the backend actually ships those endpoints.
# DAILY_STATUS_ENABLED=true
